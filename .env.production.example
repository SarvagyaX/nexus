# ==============================================================================
# NEXUS Enterprise Platform — Production Environment Template
# ==============================================================================
# Copy this file to .env.production on your production host:
#   cp .env.production.example .env.production
#
# Production Security Checklist:
# 1. Generate a strong 32-byte PostgreSQL password:
#    openssl rand -hex 32
# 2. Configure your fully qualified HTTPS domain in FRONTEND_ORIGIN and TRUSTED_HOSTS.
# 3. Ensure SESSION_COOKIE_SECURE=true is enforced.
# 4. Keep DEMO_AUTH_ENABLED=false (production startup will fail if enabled).
# 5. Never commit this file or any real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform Environment & Networking
# ------------------------------------------------------------------------------
APP_ENV=production
SERVICE_NAME=nexus-api
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PROD_PORT=8080

# Production frontend domain (must be exact HTTPS origin, no trailing slash)
FRONTEND_ORIGIN=https://nexus.example.com
TRUSTED_HOSTS=nexus.example.com,localhost

# ------------------------------------------------------------------------------
# 2. Production PostgreSQL Configuration
# (Internal to Docker network; never exposed on host ports in production)
# ------------------------------------------------------------------------------
POSTGRES_DB=nexus_prod
POSTGRES_USER=nexus_app
POSTGRES_PASSWORD=GENERATE_STRONG_RANDOM_POSTGRES_PASSWORD_HERE
POSTGRES_URL=postgresql://nexus_app:GENERATE_STRONG_RANDOM_POSTGRES_PASSWORD_HERE@postgres:5432/nexus_prod

# ------------------------------------------------------------------------------
# 3. Production Redis Configuration
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. Session & Security Configuration
# ------------------------------------------------------------------------------
SESSION_COOKIE_SECURE=true
SESSION_TTL_SECONDS=43200

# ------------------------------------------------------------------------------
# 5. Production AI Investigation Engine Configuration
# ------------------------------------------------------------------------------
LLM_PROVIDER=mock
LLM_MODEL=llama3.2
LLM_API_KEY=
OLLAMA_BASE_URL=

# ------------------------------------------------------------------------------
# 6. Production SMTP Notification & Outbound Delivery
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=YOUR_SMTP_API_KEY
SMTP_FROM_EMAIL=alerts@nexus.example.com
SMTP_USE_TLS=true
DEFAULT_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 7. Demo Seeding (Strictly Disabled in Production)
# ------------------------------------------------------------------------------
DEMO_AUTH_ENABLED=false
