# ==============================================================================
# NEXUS Enterprise Platform — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development or Docker Compose execution:
#   cp .env.example .env
#
# IMPORTANT:
# - Replace all placeholders before launching services.
# - Never commit actual .env files containing production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Platform Environment & Networking
# ------------------------------------------------------------------------------
APP_ENV=development
SERVICE_NAME=nexus-api
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_API_BASE_URL=http://localhost:8000
TRUSTED_HOSTS=*

# ------------------------------------------------------------------------------
# 2. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=nexus_dev
POSTGRES_USER=nexus_dev
POSTGRES_PASSWORD=replace-with-a-local-development-password
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
POSTGRES_URL=postgresql://nexus_dev:replace-with-a-local-development-password@postgres:5432/nexus_dev

# ------------------------------------------------------------------------------
# 3. Redis Cache & Event Bus Configuration
# ------------------------------------------------------------------------------
# Uses Docker Compose service hostname 'redis' (use redis://localhost:6379/0 outside Docker)
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 4. Session & Security Configuration
# ------------------------------------------------------------------------------
# In production, SESSION_COOKIE_SECURE must be true (requires HTTPS)
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=43200

# ------------------------------------------------------------------------------
# 5. AI Investigation Engine Configuration
# Supported providers: mock, ollama, openai
# ------------------------------------------------------------------------------
LLM_PROVIDER=mock
LLM_MODEL=llama3.2
LLM_API_KEY=
# Uses host.docker.internal inside Docker Compose (use http://localhost:11434 outside Docker)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ------------------------------------------------------------------------------
# 6. Notification & Delivery Settings (Optional SMTP & Outbound Webhooks)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@nexus.local
SMTP_USE_TLS=true
DEFAULT_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 7. Development-Only Demo Authentication & Workspace Seeding
# (Disabled and strictly rejected when APP_ENV=production)
# ------------------------------------------------------------------------------
DEMO_AUTH_ENABLED=false
DEMO_ADMIN_EMAIL=admin@nexus.local
DEMO_ADMIN_PASSWORD=replace-with-a-unique-local-demo-password
DEMO_ADMIN_DISPLAY_NAME=NEXUS Demo Administrator
DEMO_WORKSPACE_NAME=NEXUS Demo
DEMO_WORKSPACE_SLUG=nexus-demo
